{
  "title": "WageWizard API",
  "uid": "wagewizard",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "title": "Requests per second by route",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (route) (rate(http_requests_total{job=\"wagewizard-api\"}[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "title": "5xx error ratio (SLO 1%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=\"wagewizard-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"wagewizard-api\"}[5m]))", "legendFormat": "error ratio" }
      ]
    },
    {
      "title": "p95 latency (SLO 500ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"wagewizard-api\"}[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Status codes",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (status) (rate(http_requests_total{job=\"wagewizard-api\"}[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "title": "Ready api pods",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 6 },
      "targets": [
        { "expr": "kube_deployment_status_replicas_available{deployment=\"wagewizard-api\"}" }
      ]
    },
    {
      "title": "Open SSE connections",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 6 },
      "targets": [
        { "expr": "sum(sse_active_connections{job=\"wagewizard-api\"})" }
      ]
    },
    {
      "title": "Pod memory",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"wagewizard-api\"}", "legendFormat": "{{pod}}" }
      ]
    }
  ]
}
